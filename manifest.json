{
  "manifest_version": 3,
  "name": "QuickApply",
  "version": "0.0.1",
  "description": "Fast, local autofill for job applications across major ATS platforms.",
  "action": {
    "default_title": "QuickApply"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.greenhouse.io/*",
    "https://*.lever.co/*",
    "https://*.ashbyhq.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.myworkdaysite.com/*"
  ],
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.greenhouse.io/*",
        "https://*.lever.co/*",
        "https://*.ashbyhq.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.myworkdaysite.com/*"
      ],
      "js": [
        "src/content.ts"
      ],
      "all_frames": true
    }
  ],
  "side_panel": {
    "default_path": "index.html"
  }
}
